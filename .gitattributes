# Repository text uses LF across Windows and Linux.
* text=auto eol=lf
# Preserve distributed skill bytes exactly as hashed in sources.json.
skills/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Archived notices must stay byte-identical to the per-skill licenses.
licenses/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
